{
  "name": "spa-arquitetura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build && tsc --noEmit && tsc -p server --noEmit",
    "build:stats": "vite build --mode stats",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx server/db/seed.ts",
    "auth:generate": "npx auth generate --config server/auth.config.ts --output server/db/auth-schema.ts --adapter drizzle --dialect sqlite --yes",
    "lint": "oxlint && eslint .",
    "i18n:extract": "lingui extract --clean",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:integration": "vitest run --project integration",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "@lingui/core": "~5.9.5",
    "@lingui/react": "~5.9.5",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "~5.9.5",
    "@lingui/cli": "~5.9.5",
    "@lingui/conf": "~5.9.5",
    "@lingui/vite-plugin": "~5.9.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-oxlint": "~1.88.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "oxlint": "~1.88.0",
    "playwright": "^1.64.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-browser-react": "^2.3.0"
  }
}
